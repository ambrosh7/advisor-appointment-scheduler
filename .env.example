# Gemini (required for Phase 4 LLM agent tool-calling)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Workspace targets
GOOGLE_CALENDAR_ID=primary
GOOGLE_DOCS_PREBOOKING_ID=
GOOGLE_GMAIL_ADVISOR_TO=advisor@example.com

# Local Google Calendar auth (OAuth or service account)
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# On Render: paste the full JSON into GOOGLE_SERVICE_ACCOUNT_JSON (no file upload needed)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Secure post-call details link
SECURE_LINK_TEMPLATE=https://example.com/complete?ref={code}

# Educational link shown when user asks for investment advice
ADVICE_EDUCATIONAL_URL=https://example.com/learn/basics

# Railway MCP — Docs append + Gmail send (Bearer token from Railway)
MCP_SERVER_URL=https://gmail-docs-mcp-server-production.up.railway.app/mcp
MCP_HTTP_BEARER_TOKEN=

# Vapi (optional — phone/WebRTC transport; Orchestrator stays the brain)
# Custom LLM base URL in Vapi dashboard: https://<host>/v1
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
